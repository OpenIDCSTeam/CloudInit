{
  "server": {
    "enabled": true,
    "interval": 60,
    "port": 1881,
    "fallback_port": 1880,
    "path": "/api/client/upload",
    "host": "",
    "gateway_offset": 2
  },
  "features": {
    "report": true,
    "password_change": true,
    "disk_extend": true,
    "activation": true,
    "virtio": true,
